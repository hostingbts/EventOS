# Google Apps Script Web App URL (deploy → Web app)
VITE_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Same token as API_TOKEN in Apps Script properties
VITE_API_TOKEN=your-long-random-token

# Set to true to use demo data without Google (default when VITE_API_URL is empty)
# VITE_USE_MOCK=true

# Comma-separated admin emails (demo mode). Production: set ADMIN_EMAILS in Apps Script.
# VITE_ADMIN_EMAILS=lead@company.org,admin@company.org

# On Vercel: set VITE_USE_PROXY=true and add API_URL + API_TOKEN in Vercel env (see api/proxy.ts)
# VITE_USE_PROXY=true
